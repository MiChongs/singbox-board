[Unit]
Description=singbox-board root daemon (sing-box supervisor)
Documentation=https://github.com/MiChongs/sing-box
After=network-online.target nss-lookup.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/singbox-board daemon --config /etc/singbox-board/daemon.toml
# Validates the sing-box configuration, then hot-reloads it (SIGHUP).
ExecReload=/bin/kill -HUP $MAINPID
# The daemon stops sing-box itself on SIGTERM; anything left gets SIGKILL.
KillMode=mixed
TimeoutStopSec=30
Restart=on-failure
RestartSec=5s
LimitNOFILE=infinity
RuntimeDirectory=singbox-board
# /var/lib/sing-box (sing-box -D) and /var/lib/singbox-board (components)
StateDirectory=sing-box singbox-board

[Install]
WantedBy=multi-user.target
